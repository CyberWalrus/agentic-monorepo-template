{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "perf-budgets.json", "tools/ports.ts"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "reports/vitest.json"]
    },
    "test:visual": {
      "dependsOn": ["transit"],
      "outputs": [],
      // ALLOW_HOST_SCREENSHOTS разрешает скриншоты вне Linux-образа (packages/ui/vitest.config.ts).
      "env": ["ALLOW_HOST_SCREENSHOTS"]
    },
    "build": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "e2e": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["playwright-report/**", "test-results/**", "reports/**"],
      // VIDEO=on — видео прогона как доказательство для PR; без env Turborepo не передаст его и не учтёт в хеше.
      // API_URL — цель прокси /rpc; PORT_BASE — явная база портов (ADR 0005, З9); оба читает конфиг Playwright.
      "env": ["CI", "VIDEO", "API_URL", "PORT_BASE"]
    },
    "perf": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["reports/**"],
      "env": ["CI", "API_URL", "PORT_BASE"]
    },
    "mutation": {
      "dependsOn": ["transit"],
      "outputs": ["reports/mutation/**"],
      "cache": false
    }
  }
}
