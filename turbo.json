{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "perf-budgets.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:visual": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "e2e": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI"]
    },
    "perf": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["reports/**"],
      "env": ["CI"]
    },
    "mutation": {
      "dependsOn": ["transit"],
      "outputs": ["reports/mutation/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
