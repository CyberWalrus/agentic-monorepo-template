{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "perf-budgets.json", "tools/ports.ts"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "reports/vitest.json"]
    },
    "test:visual": {
      "dependsOn": ["transit"],
      "outputs": [],
      // ALLOW_HOST_SCREENSHOTS разрешает скриншоты вне Linux-образа (packages/ui/vitest.config.ts).
      // VISUAL_UPDATE=1 — запись базлайнов (A8, только человек внутри образа).
      "env": ["ALLOW_HOST_SCREENSHOTS", "VISUAL_UPDATE"]
    },
    "build": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "e2e": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["playwright-report/**", "test-results/**", "reports/**"],
      // VIDEO=on — видео прогона как доказательство для PR; без env Turborepo не передаст его и не учтёт в хеше.
      // PORT_BASE — явная база портов (ADR 0005, З9); REUSE_SERVER=1 — ручной reuse dev-сервера
      // по токену этого worktree (ADR 0005). Обе читает конфиг Playwright из process.env, и обе
      // обязаны быть объявлены: strict env-режим передаёт задаче только объявленное, а переменная
      // вне env не попадает и в хеш — кэш реплеит чужой прогон (класс дефекта VIDEO=on, §3.2).
      // API_URL здесь нет намеренно: адрес вычисляется в tools/ports.ts (apiOrigin), из env его
      // не читает никто — объявление лишь раздувало ключ кэша.
      // E2E_FEATURES — выбор фич (B4.1): без него перезапуск PR с тем же SHA
      // реплеил бы из кэша отчёт старого подмножества.
      "env": ["CI", "VIDEO", "PORT_BASE", "E2E_FEATURES", "REUSE_SERVER"]
    },
    "perf": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["reports/**"],
      // REUSE_SERVER — конфиг Playwright общий с e2e: perf-прогон переиспользует
      // ручной сервер так же (токен этого worktree).
      "env": ["CI", "PORT_BASE", "REUSE_SERVER"],
      // A7 (architecture.md §3.3): перф-замеры зависят от машины и между машинами
      // не переиспользуются — задача вне кэша вовсе (ни локального, ни remote).
      "cache": false
    },
    "mutation": {
      "dependsOn": ["transit"],
      "outputs": ["reports/mutation/**"],
      "cache": false
    },
    "//#test:hooks": {
      // E1: тесты обвязки под кэшем turbo. Явные inputs — потому что корневой
      // прогон вне пакетов: пропущенный input = тихо устаревший зелёный результат
      // (З6). Канонический список — tools/test-hooks-inputs.ts (единственное
      // место определения); расхождение ловит канарейка в test:hooks.
      "inputs": [
        "tools/**",
        ".claude/hooks/**",
        ".claude/agents/**",
        ".claude/settings.json",
        ".github/**",
        "e2e/**",
        "packages/**",
        "apps/**",
        "vitest.config.ts",
        "tsconfig.json",
        "tsconfig.base.json",
        ".dependency-cruiser.cjs",
        "knip.json",
        ".oxlintrc.json",
        "turbo.json",
        "verify-budgets.json",
        "perf-budgets.json",
        "test-count-baseline.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": ["reports/vitest-hooks.json"]
    }
  }
}
