{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "perf-budgets.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "reports/vitest.json"]
    },
    "test:visual": {
      "dependsOn": ["transit"],
      "outputs": [],
      // ALLOW_HOST_SCREENSHOTS разрешает скриншоты вне Linux-образа (packages/ui/vitest.config.ts).
      "env": ["ALLOW_HOST_SCREENSHOTS"]
    },
    "build": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "e2e": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["playwright-report/**", "test-results/**", "reports/**"],
      // VIDEO=on — видео прогона как доказательство для PR; без env Turborepo не передаст его и не учтёт в хеше.
      // API_URL — цель прокси /rpc (ADR 0005): её читает процесс preview, который запускает Playwright.
      "env": ["CI", "VIDEO", "API_URL"]
    },
    "perf": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["reports/**"],
      "env": ["CI", "API_URL"]
    },
    "mutation": {
      "dependsOn": ["transit"],
      "outputs": ["reports/mutation/**"],
      "cache": false
    },
    "dev": {
      // PORT/ENABLE_TEST_API/INSTANCE_ID читает apps/api/src/server.ts; API_URL —
      // SSR-клиент web и цель прокси /rpc (ADR 0005).
      "env": ["PORT", "ENABLE_TEST_API", "INSTANCE_ID", "API_URL"],
      "cache": false,
      "persistent": true
    }
  }
}
