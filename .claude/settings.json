{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify *)",
      "Bash(pnpm verify)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm build *)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm perf *)",
      "Bash(pnpm visual)",
      "Bash(pnpm mutation *)",
      "Bash(pnpm boundaries *)",
      "Bash(pnpm knip *)",
      "Bash(pnpm turbo run *)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * typecheck *)",
      "Bash(pnpm --filter @repo/contracts openapi)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm exec playwright trace *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__playwright",
      "mcp__playwright-test",
      "mcp__chrome-devtools"
    ],
    "deny": [
      "Bash(pnpm visual:update *)",
      "Bash(pnpm visual:update)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "enabledMcpjsonServers": ["playwright", "playwright-test", "chrome-devtools"],
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "denyWrite": [
        "**/__screenshots__/**",
        "perf-budgets.json",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        ".dependency-cruiser.cjs",
        "knip.json",
        "tsconfig.base.json",
        "lefthook.yml",
        "**/vitest.config.ts",
        "**/stryker.config.json",
        "e2e/playwright.config.ts",
        "verify-budgets.json",
        ".github/**",
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/hooks/**",
        "tools/**"
      ],
      "allowWrite": ["~/Library/pnpm/store"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": ["~/.docker/run/docker.sock"],
      "allowedDomains": ["registry.npmjs.org"]
    },
    "credentials": {
      "files": [{ "path": "~/.ssh", "mode": "deny" }],
      "envVars": [
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-result.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed-file.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-result.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.ts\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
