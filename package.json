{
  "name": "agentic-monorepo-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ -d .git ]; then lefthook install; fi",
    "dev": "node tools/dev.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "perf": "turbo run perf",
    "mutation": "turbo run mutation",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "boundaries": "depcruise apps packages e2e --config .dependency-cruiser.cjs",
    "knip": "knip",
    "sherif": "sherif",
    "bundle": "node tools/check-bundle.ts",
    "visual": "tools/visual.sh",
    "visual:update": "VISUAL_UPDATE=1 tools/visual.sh",
    "verify": "node tools/verify.ts",
    "canaries": "node tools/run-gate-canaries.ts",
    "typecheck:tools": "tsc -p tsconfig.json",
    "test:integrity": "node tools/check-test-integrity.ts",
    "test:hooks": "vitest run --reporter=json --reporter=default --outputFile=reports/vitest-hooks.json",
    "test:report": "node tools/check-test-report.ts",
    "test:count": "node tools/check-test-count.ts",
    "test:count:update": "node tools/check-test-count.ts --update",
    "sandbox:check": "node tools/check-sandbox-paths.ts",
    "docs:check": "node tools/check-docs.ts",
    "visual-image:check": "node tools/check-visual-image.ts",
    "backlog": "node tools/backlog.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
