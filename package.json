{
  "name": "agentic-monorepo-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "dev": "node tools/dev.ts",
    "preflight": "node packages/preflight/src/cli.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "perf": "turbo run perf",
    "mutation": "turbo run mutation",
    "probe:plugin": "node tools/probe-claude-plugin.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "boundaries": "depcruise apps packages e2e --config .dependency-cruiser.cjs",
    "knip": "knip",
    "sherif": "sherif",
    "bundle": "node tools/check-bundle.ts",
    "bundle:delta": "node tools/check-bundle-delta.ts",
    "secrets:check": "secretlint \"**/*\"",
    "audit:check": "node tools/check-audit.ts",
    "sbom": "pnpm sbom",
    "visual": "tools/visual.sh",
    "visual:update": "VISUAL_UPDATE=1 tools/visual.sh",
    "verify": "node tools/verify.ts",
    "canaries": "node tools/run-gate-canaries.ts && node tools/run-template-copy-canary.ts",
    "evals": "node tools/evals/run.ts",
    "typecheck:tools": "tsc -p tsconfig.json",
    "test:integrity": "node tools/check-test-integrity.ts",
    "test:hooks": "vitest run --reporter=json --reporter=default --outputFile=reports/vitest-hooks.json",
    "test:inbox": "vitest run --root tools backlog-inbox",
    "test:report": "node tools/check-test-report.ts",
    "test:count": "node tools/check-test-count.ts",
    "test:count:update": "node tools/check-test-count.ts --update",
    "sandbox:check": "node tools/check-sandbox-paths.ts",
    "registries:check": "node tools/check-registries.ts",
    "required-tasks:check": "node tools/check-required-tasks.ts",
    "routetree:check": "node tools/check-routetree-drift.ts",
    "regen": "pnpm --filter @repo/contracts openapi && pnpm --filter @repo/web routes:gen",
    "env:check": "node tools/check-env-usage.ts && node tools/check-env-example.ts",
    "denial:report": "node tools/denial-trend.ts",
    "telemetry:report": "node tools/telemetry-report.main.ts",
    "tool-class:check": "node tools/check-tool-class.ts",
    "docs:check": "node tools/check-docs.ts",
    "flaky:quarantine": "node tools/check-flaky-rate.ts --validate-quarantine --quarantine tools/flaky-quarantine.json",
    "visual-image:check": "node tools/check-visual-image.ts",
    "backlog": "node tools/backlog.ts",
    "gen": "node tools/gen.ts"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/node": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "secretlint": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
