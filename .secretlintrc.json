{
  "$schema": "./node_modules/secretlint/config/.secretlintrc.schema.json",
  // Сканер секретов (b6, решение 2026-11-15): secretlint из каталога версий.
  // Пресет recommend закрывает классы: облачные ключи, токены, приватные ключи.
  // Условие возврата (журнал b6): secretlint пропускает класс секретов, который
  // ловит gitleaks — тогда пересмотреть выбор.
  //
  // Исключения (фикстуры с синтетическими секретами, артефакты) —
  // в защищённом .secretlintignore рядом (правка — через label gate-change-approved).
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ]
}
