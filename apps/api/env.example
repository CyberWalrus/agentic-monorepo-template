# Пример окружения apps/api (C3.1). Значения — валидный локальный минимум:
# полный набор правил — единый модуль окружения apps/api/src/server-config.ts (C3.0).
# PORT обязателен: его вычисляет tools/ports.ts (pnpm dev / e2e webServer / CI).
PORT=3301
# Хост привязки: 127.0.0.1 локально, 0.0.0.0 в контейнере (ENV образа, ADR 0012).
HOST=127.0.0.1
# Строгое окружение: development | production | test.
NODE_ENV=development
# Тестовый API: '1'/'true' включают, '0'/'false' выключают.
ENABLE_TEST_API=0
ENABLE_TEST_API_WITH_DATABASE=0
# Постоянное хранилище: пусто — in-memory.
DATABASE_URL=
# Идентификатор инстанса: пусто — выведется при старте.
INSTANCE_ID=
