{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "test": "vitest run --coverage --reporter=json --reporter=default --outputFile=reports/vitest.json",
    "mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:check": "node scripts/schema-sync-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@repo/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
