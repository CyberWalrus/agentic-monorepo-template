# Пример окружения apps/web (C3.1). Правила — единый модуль apps/web/src/lib/env.ts (C3.0).
# Адрес API для прокси /rpc и SSR fetch (ADR 0005): http(s); локально значение
# из reports/ports.json после `pnpm dev`.
API_URL=http://127.0.0.1:3300
# Порт и хост process-окружения web (production-entry, C3.2).
PORT=3000
HOST=127.0.0.1
